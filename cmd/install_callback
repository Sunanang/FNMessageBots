#!/bin/bash

### This script is called after the user installs the application.

set -euo pipefail

fail_user_visible() {
    local msg="$1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf "%s\n" "${msg}" > "${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
}

# 安装失败时统一提示：Docker 版安装说明（飞牛社区）
_INSTALL_FAIL_DOCKER_HINT="请前往飞牛社区按教程安装 Docker 版本FnMessageBot：https://club.fnnas.com/forum.php?mod=viewthread&tid=57252"

if ! command -v python3 >/dev/null 2>&1; then
    fail_user_visible "安装失败：未找到 python3。${_INSTALL_FAIL_DOCKER_HINT}"
fi

PYVER="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' || true)"
if [ -z "${PYVER}" ]; then
    fail_user_visible "安装失败：无法获取 Python 版本。${_INSTALL_FAIL_DOCKER_HINT}"
fi

REQ_PY_OK="$(python3 -c 'import sys; print(int(sys.version_info >= (3,9)))' || true)"
if [ "${REQ_PY_OK}" != "1" ]; then
    fail_user_visible "安装失败：需要 Python >= 3.9，当前为 ${PYVER}。${_INSTALL_FAIL_DOCKER_HINT}"
fi

# 应用安装根目录：必须用 BASH_SOURCE（若不可用则回退 $0），系统在回调里执行时 $0 可能仅为「install_callback」不含路径。
_app_install_root() {
    local src="${BASH_SOURCE[0]:-$0}"
    cd -P "$(dirname "${src}")/.." && pwd
}

# 应用代码目录：
# - install_callback 常在 /tmp/appcenter/*-tpk 下执行，fnpack 未必把 app/server 打进 tpk
# - cmd/ 为官方「开发者定义目录」必在包内，故 Python 工程放在 cmd/fnmessagebots/
# - 安装完成后也可能出现在 ${TRIM_APPDEST}/target
resolve_app_code_dir() {
    local root cmd_dir trim_dest d
    root="$(_app_install_root)"
    cmd_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    trim_dest="${TRIM_APPDEST:-}"

    for d in \
        "${cmd_dir}/fnmessagebots" \
        "${root}/app/server" \
        "${root}/target" \
        "${root}/target/fnmessagebots"
    do
        if [ -f "${d}/requirements.txt" ] && [ -f "${d}/src/main.py" ]; then
            printf "%s" "${d}"
            return 0
        fi
    done

    if [ -n "${trim_dest}" ]; then
        for d in \
            "${trim_dest}/target" \
            "${trim_dest}/target/fnmessagebots" \
            "${trim_dest}/app/server"
        do
            if [ -f "${d}/requirements.txt" ] && [ -f "${d}/src/main.py" ]; then
                printf "%s" "${d}"
                return 0
            fi
        done
    fi
    return 1
}

if ! APP_CODE_DIR="$(resolve_app_code_dir)"; then
    fail_user_visible "安装失败：未找到应用代码目录。${_INSTALL_FAIL_DOCKER_HINT}"
fi

REQ_FILE="${APP_CODE_DIR}/requirements.txt"
DEFAULT_CONFIG_FILE="${APP_CODE_DIR}/config/config.json"

if [ ! -f "${REQ_FILE}" ]; then
    fail_user_visible "安装失败：未找到依赖文件 requirements.txt（${REQ_FILE}）。${_INSTALL_FAIL_DOCKER_HINT}"
fi

mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGVAR}/config" "${TRIM_PKGVAR}/data/logs" "${TRIM_PKGVAR}/data/cursor"

if ! touch "${TRIM_PKGVAR}/.fnmb_wtest" 2>/dev/null; then
    fail_user_visible "安装失败：无法在数据目录写入（${TRIM_PKGVAR}）。${_INSTALL_FAIL_DOCKER_HINT}"
fi
rm -f "${TRIM_PKGVAR}/.fnmb_wtest"

# 初始化配置（仅首次）
if [ ! -f "${TRIM_PKGVAR}/config/config.json" ]; then
    if [ -f "${DEFAULT_CONFIG_FILE}" ]; then
        cp -f "${DEFAULT_CONFIG_FILE}" "${TRIM_PKGVAR}/config/config.json"
    else
        fail_user_visible "安装失败：未找到默认配置（${DEFAULT_CONFIG_FILE}）。${_INSTALL_FAIL_DOCKER_HINT}"
    fi
fi

# 创建 venv 并安装依赖。NAS 上部分卷不支持 venv 默认的符号链接，优先 --copies；仍失败则 pip install --target
_append_venv_log() {
    local f="$1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ] && [ -f "${f}" ]; then
        {
            printf "\n--- venv 命令输出（节选）---\n"
            head -80 "${f}"
        } >> "${TRIM_TEMP_LOGFILE}"
    fi
    rm -f "${f}"
}

_try_create_venv() {
    local err
    err="$(mktemp)"
    rm -rf "${VENV_DIR}" 2>/dev/null || true
    # --copies：避免 FAT/exFAT 等不支持 symlink 导致失败
    if python3 -m venv --copies "${VENV_DIR}" 2>"${err}"; then
        rm -f "${err}"
        return 0
    fi
    rm -rf "${VENV_DIR}" 2>/dev/null || true
    if python3 -m venv "${VENV_DIR}" 2>"${err}"; then
        rm -f "${err}"
        return 0
    fi
    _append_venv_log "${err}"
    return 1
}

_install_with_venv() {
    rm -f "${TRIM_PKGVAR}/.use_python_target" 2>/dev/null || true
    if ! _try_create_venv; then
        return 1
    fi
    if ! "${VENV_DIR}/bin/python" -m pip --version >/dev/null 2>&1; then
        "${VENV_DIR}/bin/python" -m ensurepip --upgrade >/dev/null 2>&1 || true
    fi
    if ! "${VENV_DIR}/bin/python" -m pip --version >/dev/null 2>&1; then
        fail_user_visible "安装失败：虚拟环境已创建但 pip 不可用（${VENV_DIR}）。${_INSTALL_FAIL_DOCKER_HINT}"
    fi
    "${VENV_DIR}/bin/python" -m pip install -U pip >/dev/null 2>&1 || true
    if ! "${VENV_DIR}/bin/python" -m pip install -r "${REQ_FILE}"; then
        fail_user_visible "安装失败：Python 依赖安装失败（venv）。${_INSTALL_FAIL_DOCKER_HINT}"
    fi
    return 0
}

_install_with_target() {
    rm -rf "${PY_TARGET}" 2>/dev/null || true
    mkdir -p "${PY_TARGET}"
    : > "${TRIM_PKGVAR}/.use_python_target"
    rm -rf "${VENV_DIR}" 2>/dev/null || true
    if ! python3 -m pip install -r "${REQ_FILE}" -t "${PY_TARGET}"; then
        fail_user_visible "安装失败：无法使用虚拟环境，且 pip 依赖安装也失败（${PY_TARGET}）。${_INSTALL_FAIL_DOCKER_HINT}"
    fi
}

VENV_DIR="${TRIM_PKGVAR}/venv"
PY_TARGET="${TRIM_PKGVAR}/python_modules"

if [ -x "${VENV_DIR}/bin/python" ] && [ ! -f "${TRIM_PKGVAR}/.use_python_target" ]; then
    "${VENV_DIR}/bin/python" -m pip install -U pip >/dev/null 2>&1 || true
    if ! "${VENV_DIR}/bin/python" -m pip install -r "${REQ_FILE}"; then
        fail_user_visible "安装失败：更新 Python 依赖失败（已有 venv）。${_INSTALL_FAIL_DOCKER_HINT}"
    fi
elif [ -f "${TRIM_PKGVAR}/.use_python_target" ] && [ -d "${PY_TARGET}" ]; then
    if ! python3 -m pip install -r "${REQ_FILE}" -t "${PY_TARGET}"; then
        fail_user_visible "安装失败：更新 Python 依赖失败（target 模式）。${_INSTALL_FAIL_DOCKER_HINT}"
    fi
elif ! _install_with_venv; then
    _install_with_target
fi

exit 0