#!/bin/bash

### This script is called after the user installs the application.

set -euo pipefail

fail_user_visible() {
    local msg="$1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf "%s\n" "${msg}" > "${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
}

# 安装失败时统一提示：Docker 版安装说明（飞牛社区）
_INSTALL_FAIL_DOCKER_HINT="请前往飞牛社区按教程安装 Docker 版本FnMessageBot：https://club.fnnas.com/forum.php?mod=viewthread&tid=57252"

# Python 运行时：优先用飞牛应用商店的 python312（manifest 里 install_dep_apps 已声明），
# 应用商店没装成功时退回系统 python3，保证老环境也能装。
source "$(dirname "${BASH_SOURCE[0]}")/python_env"
fnmb_prepend_python_path

FNMB_PYTHON="$(fnmb_python_cmd || true)"
if [ -z "${FNMB_PYTHON}" ]; then
    fail_user_visible "安装失败：找不到可用的 Python 运行时（应用商店的 Python 与系统 python3 都不可用）。${_INSTALL_FAIL_DOCKER_HINT}"
fi

PYVER="$("${FNMB_PYTHON}" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' || true)"
if [ -z "${PYVER}" ]; then
    fail_user_visible "安装失败：无法获取 Python 版本。${_INSTALL_FAIL_DOCKER_HINT}"
fi

REQ_PY_OK="$("${FNMB_PYTHON}" -c 'import sys; print(int(sys.version_info >= (3,9)))' || true)"
if [ "${REQ_PY_OK}" != "1" ]; then
    fail_user_visible "安装失败：需要 Python >= 3.9，当前为 ${PYVER}。${_INSTALL_FAIL_DOCKER_HINT}"
fi

# 应用安装根目录：必须用 BASH_SOURCE（若不可用则回退 $0），系统在回调里执行时 $0 可能仅为「install_callback」不含路径。
_app_install_root() {
    local src="${BASH_SOURCE[0]:-$0}"
    cd -P "$(dirname "${src}")/.." && pwd
}

# 应用代码目录：
# - install_callback 常在 /tmp/appcenter/*-tpk 下执行，fnpack 未必把 app/server 打进 tpk
# - cmd/ 为官方「开发者定义目录」必在包内，故 Python 工程放在 cmd/fnmessagebots/
# - 安装完成后也可能出现在 ${TRIM_APPDEST}/target
resolve_app_code_dir() {
    local root cmd_dir trim_dest d
    root="$(_app_install_root)"
    cmd_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    trim_dest="${TRIM_APPDEST:-}"

    for d in \
        "${cmd_dir}/fnmessagebots" \
        "${root}/app/server" \
        "${root}/target" \
        "${root}/target/fnmessagebots"
    do
        if [ -f "${d}/requirements.txt" ] && [ -f "${d}/src/main.py" ]; then
            printf "%s" "${d}"
            return 0
        fi
    done

    if [ -n "${trim_dest}" ]; then
        for d in \
            "${trim_dest}/target" \
            "${trim_dest}/target/fnmessagebots" \
            "${trim_dest}/app/server"
        do
            if [ -f "${d}/requirements.txt" ] && [ -f "${d}/src/main.py" ]; then
                printf "%s" "${d}"
                return 0
            fi
        done
    fi
    return 1
}

if ! APP_CODE_DIR="$(resolve_app_code_dir)"; then
    fail_user_visible "安装失败：未找到应用代码目录。${_INSTALL_FAIL_DOCKER_HINT}"
fi

REQ_FILE="${APP_CODE_DIR}/requirements.txt"
DEFAULT_CONFIG_FILE="${APP_CODE_DIR}/config/config.json"

if [ ! -f "${REQ_FILE}" ]; then
    fail_user_visible "安装失败：未找到依赖文件 requirements.txt（${REQ_FILE}）。${_INSTALL_FAIL_DOCKER_HINT}"
fi

source "$(dirname "${BASH_SOURCE[0]}")/data_permissions"
prepare_app_data_permissions

mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGVAR}/config" "${TRIM_PKGVAR}/data/logs" "${TRIM_PKGVAR}/data/cursor"

if ! touch "${TRIM_PKGVAR}/.fnmb_wtest" 2>/dev/null; then
    fail_user_visible "安装失败：无法在数据目录写入（${TRIM_PKGVAR}）。${_INSTALL_FAIL_DOCKER_HINT}"
fi
rm -f "${TRIM_PKGVAR}/.fnmb_wtest"

source "$(dirname "${BASH_SOURCE[0]}")/ui_port"
# 覆盖安装也可能执行 install_callback；安装向导默认值不能改掉原监听端口。
if [ -f "${TRIM_PKGVAR}/config/config.json" ] || [ -e "${TRIM_PKGVAR}/config/ui_port" ]; then
    save_fnmb_ui_port
elif [ "${wizard_ui_port+x}" = x ]; then
    save_fnmb_ui_port "${wizard_ui_port}"
else
    save_fnmb_ui_port
fi

# 初始化配置（仅首次）
FNMB_FRESH_CONFIG=0
if [ ! -f "${TRIM_PKGVAR}/config/config.json" ]; then
    if [ -f "${DEFAULT_CONFIG_FILE}" ]; then
        cp -f "${DEFAULT_CONFIG_FILE}" "${TRIM_PKGVAR}/config/config.json"
        FNMB_FRESH_CONFIG=1
    else
        fail_user_visible "安装失败：未找到默认配置（${DEFAULT_CONFIG_FILE}）。${_INSTALL_FAIL_DOCKER_HINT}"
    fi
fi

# 安装向导设置的访问密码：只写入 PBKDF2 盐值与哈希（与 web/auth_service.py 一致），明文不落盘、不输出。
# 未经向导安装（变量为空）时跳过，应用启动后走初始化码流程。
if [ "${FNMB_FRESH_CONFIG}" = "1" ] && [ -n "${wizard_web_password:-}" ]; then
    set +e
    FNMB_PW="${wizard_web_password}" \
    FNMB_PW2="${wizard_web_password_confirm:-}" \
    FNMB_CFG="${TRIM_PKGVAR}/config/config.json" \
    "${FNMB_PYTHON}" - <<'PY'
import hashlib
import json
import os
import secrets
import sys
import tempfile

pw = os.environ["FNMB_PW"].strip()
if len(pw) < 8:
    sys.exit(2)
if pw != os.environ.get("FNMB_PW2", "").strip():
    sys.exit(3)
cfg = os.environ["FNMB_CFG"]
with open(cfg, encoding="utf-8") as f:
    data = json.load(f)
salt = secrets.token_hex(16)
data["web_password_salt"] = salt
data["web_password_hash"] = hashlib.pbkdf2_hmac("sha256", pw.encode("utf-8"), bytes.fromhex(salt), 100000).hex()
data["web_password_enabled"] = True
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(cfg))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, cfg)
PY
    _pw_rc=$?
    set -e
    case "${_pw_rc}" in
        0) rm -f "${TRIM_PKGVAR}/config/.setup_code" ;;
        2) fail_user_visible "安装失败：访问密码长度至少 8 位。" ;;
        3) fail_user_visible "安装失败：两次输入的访问密码不一致。" ;;
        *) fail_user_visible "安装失败：写入访问密码失败（${TRIM_PKGVAR}/config/config.json）。" ;;
    esac
fi
chmod 600 "${TRIM_PKGVAR}/config/config.json" 2>/dev/null || true

# 依赖安装（2.9.0 起）：统一装到 ${TRIM_PKGVAR}/python_modules（--target 模式），
# 不再创建 venv —— 飞牛的部分存储卷不支持 venv 的符号链接，离线 wheels 也省掉每次安装重新下载。
# 顺序由 fnmb_install_requirements 决定：包内 wheels + uv → 包内 wheels + pip → 联网 pip。
FNMB_APP_CODE_DIR="${APP_CODE_DIR}"
export FNMB_APP_CODE_DIR
PY_TARGET="${TRIM_PKGVAR}/python_modules"
VENV_DIR="${TRIM_PKGVAR}/venv"

# 先装到临时目录，成功后再替换：装失败时上一份能跑的依赖原样留着，不会把应用装成半残
PY_STAGE="${PY_TARGET}.new"
rm -rf "${PY_STAGE}" 2>/dev/null || true
mkdir -p "${PY_STAGE}" 2>/dev/null || fail_user_visible "安装失败：无法创建依赖目录（${PY_STAGE}）。${_INSTALL_FAIL_DOCKER_HINT}"

if ! fnmb_install_requirements "${FNMB_PYTHON}" "${REQ_FILE}" "${PY_STAGE}"; then
    if [ -n "${FNMB_INSTALL_ERROR_LOG:-}" ] && [ -f "${FNMB_INSTALL_ERROR_LOG}" ]; then
        printf "\n--- 依赖安装最后一段输出（节选）---\n" >> "${TRIM_TEMP_LOGFILE:-/dev/null}"
        tail -40 "${FNMB_INSTALL_ERROR_LOG}" >> "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
        rm -f "${FNMB_INSTALL_ERROR_LOG}"
    fi
    fail_user_visible "安装失败：Python 依赖安装失败（离线依赖包与联网源都没装上）。${_INSTALL_FAIL_DOCKER_HINT}"
fi

rm -rf "${PY_TARGET}" 2>/dev/null || true
mv "${PY_STAGE}" "${PY_TARGET}" || fail_user_visible "安装失败：无法启用依赖目录（${PY_TARGET}）。${_INSTALL_FAIL_DOCKER_HINT}"

# 记录本次使用的模式与解释器：main 直接照这两个文件启动，不再重新猜
: > "${TRIM_PKGVAR}/.use_python_target"
printf '%s\n' "${FNMB_PYTHON}" > "${TRIM_PKGVAR}/.fnmb_python"
chmod 600 "${TRIM_PKGVAR}/.fnmb_python" 2>/dev/null || true
# 旧版本留下的 venv 用完即弃，避免同一份依赖存两遍
rm -rf "${VENV_DIR}" 2>/dev/null || true

prepare_app_data_permissions

exit 0
