#!/bin/bash

### This script is called after the user upgrades the application.
### 升级后刷新 Python 依赖（如新增 croniter），不覆盖已有 config.json。

set -euo pipefail

fail_user_visible() {
    local msg="$1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf "%s\n" "${msg}" > "${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
}

_FAIL_HINT="请前往飞牛社区按教程安装 Docker 版本FnMessageBot：https://club.fnnas.com/forum.php?mod=viewthread&tid=57252"

# Python 运行时：优先用飞牛应用商店的 python312（manifest 里 install_dep_apps 已声明），
# 应用商店没装成功时退回系统 python3。
source "$(dirname "${BASH_SOURCE[0]}")/python_env"
fnmb_prepend_python_path

FNMB_PYTHON="$(fnmb_python_cmd || true)"
if [ -z "${FNMB_PYTHON}" ]; then
    fail_user_visible "升级失败：找不到可用的 Python 运行时（应用商店的 Python 与系统 python3 都不可用）。${_FAIL_HINT}"
fi

REQ_PY_OK="$("${FNMB_PYTHON}" -c 'import sys; print(int(sys.version_info >= (3,9)))' || true)"
if [ "${REQ_PY_OK}" != "1" ]; then
    fail_user_visible "升级失败：需要 Python >= 3.9。${_FAIL_HINT}"
fi

_app_install_root() {
    local src="${BASH_SOURCE[0]:-$0}"
    cd -P "$(dirname "${src}")/.." && pwd
}

resolve_app_code_dir() {
    local root cmd_dir trim_dest d
    root="$(_app_install_root)"
    cmd_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    trim_dest="${TRIM_APPDEST:-}"

    for d in \
        "${cmd_dir}/fnmessagebots" \
        "${root}/app/server" \
        "${root}/target" \
        "${root}/target/fnmessagebots"
    do
        if [ -f "${d}/requirements.txt" ] && [ -f "${d}/src/main.py" ]; then
            printf "%s" "${d}"
            return 0
        fi
    done

    if [ -n "${trim_dest}" ]; then
        for d in \
            "${trim_dest}/target" \
            "${trim_dest}/target/fnmessagebots" \
            "${trim_dest}/app/server"
        do
            if [ -f "${d}/requirements.txt" ] && [ -f "${d}/src/main.py" ]; then
                printf "%s" "${d}"
                return 0
            fi
        done
    fi
    return 1
}

if ! APP_CODE_DIR="$(resolve_app_code_dir)"; then
    fail_user_visible "升级失败：未找到应用代码目录。${_FAIL_HINT}"
fi

REQ_FILE="${APP_CODE_DIR}/requirements.txt"
if [ ! -f "${REQ_FILE}" ]; then
    fail_user_visible "升级失败：未找到 requirements.txt。${_FAIL_HINT}"
fi

source "$(dirname "${BASH_SOURCE[0]}")/data_permissions"
prepare_app_data_permissions

mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGVAR}/config" "${TRIM_PKGVAR}/data/logs" "${TRIM_PKGVAR}/data/cursor"
source "$(dirname "${BASH_SOURCE[0]}")/ui_port"
save_fnmb_ui_port
chmod 600 "${TRIM_PKGVAR}/config/config.json" 2>/dev/null || true

# 依赖安装（2.9.0 起）：与 install_callback 一致，统一用 --target 模式 + 包内离线 wheels。
FNMB_APP_CODE_DIR="${APP_CODE_DIR}"
export FNMB_APP_CODE_DIR
PY_TARGET="${TRIM_PKGVAR}/python_modules"
PY_STAGE="${PY_TARGET}.new"
VENV_DIR="${TRIM_PKGVAR}/venv"

rm -rf "${PY_STAGE}" 2>/dev/null || true
mkdir -p "${PY_STAGE}" 2>/dev/null || fail_user_visible "升级失败：无法创建依赖目录（${PY_STAGE}）。${_FAIL_HINT}"

if ! fnmb_install_requirements "${FNMB_PYTHON}" "${REQ_FILE}" "${PY_STAGE}"; then
    if [ -n "${FNMB_INSTALL_ERROR_LOG:-}" ] && [ -f "${FNMB_INSTALL_ERROR_LOG}" ]; then
        printf "\n--- 依赖安装最后一段输出（节选）---\n" >> "${TRIM_TEMP_LOGFILE:-/dev/null}"
        tail -40 "${FNMB_INSTALL_ERROR_LOG}" >> "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
        rm -f "${FNMB_INSTALL_ERROR_LOG}"
    fi
    rm -rf "${PY_STAGE}" 2>/dev/null || true
    fail_user_visible "升级失败：Python 依赖安装失败（离线依赖包与联网源都没装上），原依赖目录未改动。${_FAIL_HINT}"
fi

rm -rf "${PY_TARGET}" 2>/dev/null || true
mv "${PY_STAGE}" "${PY_TARGET}" || fail_user_visible "升级失败：无法启用依赖目录（${PY_TARGET}）。${_FAIL_HINT}"

: > "${TRIM_PKGVAR}/.use_python_target"
printf '%s\n' "${FNMB_PYTHON}" > "${TRIM_PKGVAR}/.fnmb_python"
chmod 600 "${TRIM_PKGVAR}/.fnmb_python" 2>/dev/null || true
# 旧版本留下的 venv 不再使用，直接清掉，避免同一份依赖存两遍
rm -rf "${VENV_DIR}" 2>/dev/null || true

prepare_app_data_permissions

exit 0
